module Kessel
  module Auth
    include RetryHandler

    # Retry logic with exponential backoff and jitter for transient HTTP failures
    module RetryHandler
      DEFAULT_MAX_RETRIES: Integer
      DEFAULT_BASE_DELAY: Float
      DEFAULT_MAX_DELAY: Float
      RETRYABLE_NETWORK_ERRORS: Array[Class]
      RETRYABLE_HTTP_STATUSES: Array[Integer]

      def with_retry: (?max_retries: Integer, ?base_delay: Float, ?max_delay: Float) { () -> untyped } -> untyped

      private

      def backoff_delay: (Integer attempt, Float base_delay, Float max_delay) -> Float
      def retryable_http_error?: (StandardError error) -> bool
      def extract_http_status: (StandardError error) -> Integer?
      def backoff_delay_for_http_error: (StandardError error, Integer attempt, Float base_delay, Float max_delay) -> Float
      def extract_retry_after: (StandardError error) -> Float?
      def parse_retry_after_date: (String header) -> Float?
    end

    # Exception raised when OAuth functionality is requested but dependencies are missing
    class OAuthDependencyError < StandardError
      def initialize: (?String message) -> void
    end

    # Exception raised when OAuth authentication fails
    class OAuthAuthenticationError < StandardError
      def initialize: (?String message) -> void
    end

    # Structure containing OIDC discovery metadata
    class OIDCDiscoveryMetadata < Struct
      attr_accessor token_endpoint: String
      def initialize: (String token_endpoint) -> void
    end

    # Response structure for OAuth token refresh
    class RefreshTokenResponse < Struct
      attr_accessor access_token: String
      attr_accessor expires_at: Time
      def initialize: (String access_token, Integer expires_at) -> void
    end

    # Interface for authentication request objects
    module AuthRequest
      # Configures the given request with authentication headers/credentials
      def configure_request: (Net::HTTPRequest request) -> void
    end

    # Module method for performing OIDC discovery
    def fetch_oidc_discovery: (String provider_url) -> OIDCDiscoveryMetadata

    # Creates an OAuth2 authentication request object
    def oauth2_auth_request: (OAuth2ClientCredentials credentials) -> OAuth2AuthRequest

    # Checks if the openid_connect gem is available
    private
    def check_dependencies!: () -> void

    # OpenID Connect Client Credentials flow implementation
    class OAuth2ClientCredentials
      @token_mutex: Mutex
      @generation: Integer

      def initialize: (client_id: String, client_secret: String, token_endpoint: String) -> void
      def get_token: (?force_refresh: bool) -> RefreshTokenResponse

      private

      def token_valid?: () -> bool
      def refresh: () -> RefreshTokenResponse
      def create_oidc_client: () -> untyped
    end

    # OAuth2 authentication request implementation
    class OAuth2AuthRequest
      include AuthRequest

      def initialize: (OAuth2ClientCredentials credentials) -> void
      def configure_request: (Net::HTTPRequest request) -> void
    end
  end
end
